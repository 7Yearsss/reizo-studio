{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["react-hooks"],
  "ignorePatterns": ["dist/", "out/", ".vite/", "artifacts/", "integrations/", ".cache/", "src/renderer/vendor/presenton/"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "@typescript-eslint/ban-types": "off", "@typescript-eslint/no-empty-function": "off" }
    }
  ],
  "settings": {
    "import/resolver": {
      "typescript": { "project": "./tsconfig.json" }
    }
  }
}
